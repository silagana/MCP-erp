DATABASE_URL=postgresql://user:pass@host:5432/mcp_erp_dbname

# Modelo (orchestrator): Groq (API compatible con OpenAI), qwen/qwen3.8-27b.
# Se migró desde Anthropic directo el 2026-09-16 por una cuenta trabada en
# revisión sin ETA — ver docstring de app/orchestrator.py.
GROQ_API_KEY=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# URL pública del servicio (sin barra final) — usada para armar los links
# de /reportes/<token> que manda generar_dashboard.
PUBLIC_BASE_URL=https://mcp-erp-production-XXXX.up.railway.app

# Solo si se usa el canal de prueba de Telegram (app/telegram_webhook.py) —
# mismo servicio, no hace falta nada aparte en Railway.
TELEGRAM_BOT_TOKEN=

# Solo para scripts/migrate_from_st_clares.py (migración única, no se usa en runtime)
SOURCE_DATABASE_URL=postgresql://user:pass@host:5432/st_clares_dbname
