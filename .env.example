DATABASE_URL=postgresql://user:pass@host:5432/mcp_erp_dbname
ANTHROPIC_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# URL pública del servicio de WhatsApp (sin barra final) — usada para armar
# los links de /reportes/<token> que manda generar_dashboard.
PUBLIC_BASE_URL=https://mcp-erp-production-XXXX.up.railway.app

# Solo para el canal de prueba de Telegram (app/telegram_webhook.py) —
# deploy separado, ver README. No afecta nada de lo de arriba.
TELEGRAM_BOT_TOKEN=

# Solo para scripts/migrate_from_st_clares.py (migración única, no se usa en runtime)
SOURCE_DATABASE_URL=postgresql://user:pass@host:5432/st_clares_dbname
